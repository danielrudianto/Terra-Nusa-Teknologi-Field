<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Push & pull data. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- LOCATION IS DELIBERATELY NOT DECLARED (for now).
         It was here for the attendance geofence, but attendance is on hold
         (Features.attendance = false), so the app never asks for location.
         A location permission the app does not use complicates the Play
         Store "Data safety" review for nothing. When attendance returns,
         restore:
           <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
           <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
         and update the data-safety form + privacy policy to declare it. -->

    <!-- Casting stopwatch notification (Android 13+ asks for permission). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Scheduled reminders (TM 20 minutes, pause, idle, drill log) are
         Android alarms. A reboot CLEARS every pending alarm, and so does
         replacing the app with a new build. Without this permission and the
         receiver below, a phone that restarts mid-pour simply stops buzzing
         — with nothing on screen to say so. It is a normal permission: no
         prompt, and it is NOT the exact-alarm permission (SCHEDULE_EXACT_ALARM),
         which Play questions for an app that is not a clock. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- CAMERA IS DELIBERATELY NOT DECLARED.
         Photos are taken through the phone's built-in camera app (image_picker →
         ACTION_IMAGE_CAPTURE). If CAMERA is declared but not yet
         granted, Android REJECTS that intent; without the declaration, the
         built-in camera runs without any extra permission. -->

    <!-- Stamped attendance photos are also copied to the gallery (album
         "TerraBot Field"). Android 10 and older need this permission to write
         there; Android 11+ writes through MediaStore without it. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:label="TerraBot Field"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- The "Selesai TM" button on the stopwatch notification. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver" />
        <!-- Fires the 20-minute pour reminder even when the app is closed. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />

        <!-- Puts the pending reminders back after a reboot or an app update.
             MY_PACKAGE_REPLACED matters as much as BOOT_COMPLETED here: every
             new build installed over the old one wipes the alarms too.
             The QUICKBOOT actions are the same thing on HTC and some Chinese
             ROMs, which do not send BOOT_COMPLETED. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Finds the built-in camera app (Android 11+ package visibility). -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>
</manifest>
